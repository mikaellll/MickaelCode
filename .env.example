# Django Core Settings
DEBUG=True
SECRET_KEY=your-django-secret-key-must-be-long-and-random
ALLOWED_HOSTS=localhost,127.0.0.1,mickaelcode.com,*.railway.app
SITE_URL=http://127.0.0.1:8000

# Database (defaults to SQLite in development; PostgreSQL in production)
# Example PostgreSQL: postgres://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Cloudflare R2 Media Storage (Persistent file uploads in production)
USE_R2=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mickaelcode-media
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=media.mickaelcode.com

# Stripe Payments & Webhooks
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Newsletter & Marketing (Brevo / MailerLite)
NEWSLETTER_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_LIST_ID=2

# Video Hosting & Protection (Bunny Stream / Mux / Signed Embeds)
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# Email & Support
DEFAULT_FROM_EMAIL=MickaelCode <contact@mickaelcode.com>
CONTACT_EMAIL=mickaelbn@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_login
# EMAIL_HOST_PASSWORD=your_password
